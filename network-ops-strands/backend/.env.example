AWS_REGION=us-east-1
DATA_BUCKET_NAME=
ENVIRONMENT=local
LOG_LEVEL=INFO

# AgentCore Memory (optional — set to enable conversation persistence)
# Run: python scripts/setup_memory.py to create the resource
MEMORY_ID=

# MCP External Context (optional — set for production HTTP transport)
# Leave empty for local stdio transport (auto-spawned)
MCP_EXTERNAL_CONTEXT_URL=
